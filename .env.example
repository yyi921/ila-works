# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# Encryption keys for secrets at rest (OAuth tokens), comma-separated, newest first.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing every key makes stored tokens unreadable (users would need to reconnect Xero).
FIELD_ENCRYPTION_KEYS=

# Postgres
POSTGRES_DB=ila
POSTGRES_USER=ila
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Xero OAuth 2.0 (https://developer.xero.com/app/manage)
# The redirect URI must exactly match one registered on the Xero app.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/xero/callback/
# Optional: override the read-only default scope list in config/settings.py.
# XERO_SCOPES=
